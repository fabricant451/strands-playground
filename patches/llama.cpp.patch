+static std::string strands_whitespace(const std::string & text, bool collapse) {
+    std::vector<uint32_t> cps;
+    for (size_t offset = 0; offset < text.size();) {
+        const auto parsed = common_parse_utf8_codepoint(text, offset);
+        if (parsed.status != utf8_parse_result::SUCCESS) {
+            throw std::invalid_argument("Strands input contains invalid UTF-8");
+        }
+        cps.push_back(parsed.codepoint);
+        offset += parsed.bytes_consumed;
+    }
+    auto space = [](uint32_t cp) {
+        return (cp >= 0x09 && cp <= 0x0d) || (cp >= 0x1c && cp <= 0x20) || cp == 0x85 || cp == 0xa0 ||
+               cp == 0x1680 || (cp >= 0x2000 && cp <= 0x200a) || cp == 0x2028 || cp == 0x2029 ||
+               cp == 0x202f || cp == 0x205f || cp == 0x3000;
+    };
+    size_t first = 0, last = cps.size();
+    while (first < last && space(cps[first])) { ++first; }
+    while (last > first && space(cps[last - 1])) { --last; }
+    std::string out;
+    bool pending = false;
+    for (size_t i = first; i < last; ++i) {
+        if (collapse && space(cps[i])) { pending = true; continue; }
+        if (pending) { out += ' '; pending = false; }
+        out += common_unicode_cpt_to_utf8(cps[i]);
+    }
+    return out;
+}
+
+static std::string strands_content(const json & value) {
+    if (value.is_null()) { return ""; }
+    return value.is_string() ? strands_whitespace(value.get<std::string>(), false) : value.dump(2);
+}
+
+void server_decision_context::fill_task_strands(const json & state, const server_decision_question & question, server_task & task) const {
+    const std::string state_text = "<state>\n" + strands_content(state) + "\n</state>\n";
+    const char * header = question.type == SERVER_DECISION_QUESTION_CHOICE ? "Select exactly one option." :
+                         question.type == SERVER_DECISION_QUESTION_SCORE ? "Rate the state against the ordered levels below (lowest first)." :
+                         "Decide whether the statement is true of the state.";
+    std::string suffix = "<question type=\"" + std::string(decision_question_type_name(question.type)) + "\">\n" + header + "\n" + strands_content(question.instructions) + "\n<options>\n";
+    std::vector<std::pair<size_t, size_t>> spans;
+    for (size_t i = 0; i < question.options.size(); ++i) {
+        const auto & option = question.options[i];
+        const size_t start = suffix.size();
+        suffix += std::to_string(i + 1) + ". " + option.key;
+        const auto description = strands_whitespace(strands_content(option.description), true);
+        if (!description.empty()) { suffix += " \xE2\x80\x94 " + description; }
+        spans.emplace_back(start, suffix.size());
+        suffix += '\n';
+    }
+    suffix += "</options>\n</question>\n<answer>";
+    llama_tokens tokens = common_tokenize(vocab, state_text, true, true);
+    const auto question_tokens = common_tokenize(vocab, suffix, false, true);
+    if (tokens.size() + question_tokens.size() > strands_window) {
+        throw std::invalid_argument("Strands prompt exceeds the context window; shorten the state or question");
+    }
+    std::vector<std::pair<size_t, size_t>> offsets;
+    std::string decoded;
+    for (const auto token : question_tokens) {
+        const size_t start = decoded.size();
+        decoded += common_token_to_piece(vocab, token, true);
+        offsets.emplace_back(start, decoded.size());
+    }
+    if (decoded != suffix) { throw std::runtime_error("Strands tokenizer did not preserve the question text"); }
+    for (const auto & span : spans) {
+        int32_t marker = -1;
+        for (size_t i = 0; i < offsets.size(); ++i) {
+            if (offsets[i].first >= span.first && offsets[i].second <= span.second && offsets[i].second > offsets[i].first) {
+                marker = tokens.size() + i;
+            }
+        }
+        if (marker < 0) { throw std::invalid_argument("Strands option has no token"); }
+        task.decision.markers.push_back(marker);
+    }
+    tokens.insert(tokens.end(), question_tokens.begin(), question_tokens.end());
+    task.decision.pointer = tokens.size() - 1;
+    task.tokens = server_tokens(tokens, false);
+}
