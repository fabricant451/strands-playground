+        if (type == COMMON_DECISION_TYPE_STRANDS) {
+            double variance = 0.0;
+            for (size_t i = 0; i < n; ++i) {
+                variance += probs[i] * (i - expected) * (i - expected);
+            }
+            const double ceiling = (n - 1) / 2.0;
+            const double floor = std::sqrt(ordinal_smoothing);
+            const double sigma = std::sqrt(variance);
+            answer["confidence"] = ceiling <= floor ? (sigma <= floor ? 1.0 : 0.0) : std::clamp((ceiling - sigma) / (ceiling - floor), 0.0, 1.0);
+        } else {
