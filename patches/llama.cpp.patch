new file mode 100644
index 0000000..0f431f6
--- /dev/null
+++ b/conversion/strands.py
@@ -0,0 +1,64 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import torch
+from safetensors.torch import load_file
+
+from .base import ModelBase, gguf
+from .lev import _DecisionLoraMixin, _load_decision_lora_hparams
+from .qwen import Qwen3_5TextModel
+
+
+@ModelBase.register_hparams_loader(lambda path: (path / "hobson_config.json").is_file())
+def _load_strands_hparams(path: Path):
+    return _load_decision_lora_hparams(path, "StrandsDeciderModel")
+
+
+@ModelBase.register("StrandsDeciderModel")
+@ModelBase.example("StrandsAgents/strands-decider-2B-hobson-v19")
+class StrandsDeciderModel(_DecisionLoraMixin, Qwen3_5TextModel):
+    model_arch = gguf.MODEL_ARCH.QWEN35
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.decision_config = json.loads((self.dir_adapter / "hobson_config.json").read_text())
+        if self.decision_config["head_type"] != "pointer":
+            raise ValueError("only the Strands pointer head is supported")
+        self.head = load_file(self.dir_adapter / "head.safetensors")
+        if set(self.head) != {"norm.weight", "norm.bias", "q.weight", "q.bias", "k.weight", "k.bias"}:
+            raise ValueError("unexpected Strands head tensors")
+
+    def set_vocab(self):
+        super().set_vocab()
+        self.gguf_writer.add_chat_template([{"name": "systemone", "template": "{{ state }}"}])
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        config = self.decision_config
+        self.gguf_writer.add_decision_type("strands")
+        self.gguf_writer.add_embedding_length_out(2 * config["pointer_dim"])
+        self.gguf_writer.add_context_length(config["max_length"])
+        for kind in ("choice", "score", "noul"):
+            self.gguf_writer.add_decision_temperature(kind, config["temperature_by_kind"].get(kind, config["temperature"]))
+        self.gguf_writer.add_float32("qwen35.decision.ordinal_smoothing", config["ordinal_smoothing"])
+        self.gguf_writer.add_layer_norm_eps(1e-5)
+        self.gguf_writer.add_string("qwen35.decision.prompt_version", "hobson-v19")
+
+    def generate_extra_tensors(self):
+        yield from super().generate_extra_tensors()
+        for suffix in ("weight", "bias"):
+            yield f"cls.norm.{suffix}", self.head[f"norm.{suffix}"].float()
+            yield f"cls.output.{suffix}", torch.cat([self.head[f"q.{suffix}"], self.head[f"k.{suffix}"]], dim=0).float()
+
+    def modify_tensors(self, data_torch, name, bid):
+        if name.startswith("cls."):
+            yield name, data_torch
+        else:
+            yield from super().modify_tensors(data_torch, name, bid)
+
+    def tensor_force_quant(self, name, new_name, bid, n_dims):
+        if new_name.startswith("cls."):
+            return gguf.GGMLQuantizationType.F32
+        return super().tensor_force_quant(name, new_name, bid, n_dims)
