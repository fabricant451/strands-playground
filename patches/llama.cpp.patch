index 0000000..5e40d2c
--- /dev/null
+++ b/tests/test-strands.cpp
@@ -0,0 +1,54 @@
+#include "llama.h"
+#include "server-decision.h"
+
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+
+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        std::cerr << "usage: test-strands model.gguf reference.json\n";
+        return 1;
+    }
+    auto params = llama_model_default_params();
+    params.vocab_only = true;
+    llama_model * model = llama_model_load_from_file(argv[1], params);
+    if (!model) { return 1; }
+    int result = 0;
+    try {
+        server_decision_context decision;
+        decision.init(model);
+        std::ifstream file(argv[2]);
+        std::ostringstream content;
+        content << file.rdbuf();
+        const auto fixtures = json::parse(content.str());
+        size_t checked = 0;
+        for (const auto & fixture : fixtures) {
+            const auto & request = fixture.at("request");
+            const auto questions = decision.parse_questions(request);
+            for (size_t i = 0; i < questions.size(); ++i) {
+                server_task task(SERVER_TASK_TYPE_DECISION);
+                decision.fill_task(request.at("state"), questions, questions[i], 0, {}, nullptr, mtmd_helper_init_opt_default(), task);
+                const auto expected = fixture.at("tokens").at(i).get<std::vector<int32_t>>();
+                if (expected.size() != task.tokens.size()) { throw std::runtime_error("token count mismatch"); }
+                for (size_t j = 0; j < expected.size(); ++j) {
+                    if (expected[j] != task.tokens[j]) { throw std::runtime_error("token ID mismatch at " + std::to_string(j)); }
+                }
+                if (task.decision.markers != fixture.at("option_positions").at(i).get<std::vector<int32_t>>()) {
+                    throw std::runtime_error("option positions differ");
+                }
+                if (task.decision.pointer != fixture.at("answer_positions").at(i).get<int32_t>()) {
+                    throw std::runtime_error("answer position differs");
+                }
+                ++checked;
+            }
+        }
+        std::cout << "Exact token IDs and pointer positions match for " << checked << " questions\n";
+    } catch (const std::exception & e) {
+        std::cerr << e.what() << '\n';
+        result = 1;
+    }
+    llama_model_free(model);
+    return result;
+}
